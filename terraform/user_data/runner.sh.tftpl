#!/usr/bin/env bash
#
# Bootstrap for the self-hosted GitHub Actions runner.
#
# Everything is appended to a single log so a failed registration can be read
# back over SSM without guessing where cloud-init put the output. The personal
# access token and the registration token derived from it are never printed:
# curl reads the PAT from an environment variable and writes only the parsed
# result to a variable, so neither value reaches the log even on failure.
set -euo pipefail

LOG_FILE="/var/log/flyway-runner-bootstrap.log"
exec >>"$${LOG_FILE}" 2>&1

log() { echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] $*"; }

log "=== Flyway runner bootstrap starting ==="

# libicu is a hard dependency of the .NET-based runner binary; without it
# config.sh fails with an opaque error. mariadb105 provides the mysql client for
# the connectivity checks in the README, and Corretto 17 is what the Flyway CLI
# runs on.
log "Installing packages"
dnf install -y libicu tar gzip jq mariadb105 java-17-amazon-corretto-headless

RUNNER_USER="ghrunner"
RUNNER_HOME="/home/$${RUNNER_USER}"
RUNNER_DIR="$${RUNNER_HOME}/actions-runner"

# The runner refuses to run as root, and it should: workflow steps execute with
# the runner's identity, so every job on this host would otherwise be root.
if ! id -u "$${RUNNER_USER}" >/dev/null 2>&1; then
  log "Creating service user $${RUNNER_USER}"
  useradd -m -s /bin/bash "$${RUNNER_USER}"
fi

RUNNER_VERSION="${runner_version}"
TARBALL="actions-runner-linux-x64-$${RUNNER_VERSION}.tar.gz"

# The version is pinned rather than resolved to "latest" so a new runner release
# cannot change the build environment between two applies.
#
# No SHA256 is asserted here because inventing one would be worse than omitting
# it: a wrong checksum fails the boot, and a fabricated one that happens to be
# skipped proves nothing. Confirm the published digest for this version at
# https://github.com/actions/runner/releases/tag/v$${RUNNER_VERSION} (each
# release page lists the checksum for every asset) and add a `sha256sum -c`
# step here if you need supply-chain verification.
log "Downloading actions runner $${RUNNER_VERSION}"
install -d -o "$${RUNNER_USER}" -g "$${RUNNER_USER}" "$${RUNNER_DIR}"
curl -fsSL -o "/tmp/$${TARBALL}" \
  "https://github.com/actions/runner/releases/download/v$${RUNNER_VERSION}/$${TARBALL}"
tar xzf "/tmp/$${TARBALL}" -C "$${RUNNER_DIR}"
rm -f "/tmp/$${TARBALL}"
chown -R "$${RUNNER_USER}:$${RUNNER_USER}" "$${RUNNER_DIR}"

# Registration tokens are valid for one hour and for one registration. Exchanging
# the long-lived PAT for one here means the PAT itself never lands on disk.
log "Requesting a runner registration token"
GITHUB_PAT="${github_pat}"
REG_RESPONSE="$(curl -fsS -X POST \
  -H "Accept: application/vnd.github+json" \
  -H "Authorization: Bearer $${GITHUB_PAT}" \
  -H "X-GitHub-Api-Version: 2022-11-28" \
  "https://api.github.com/repos/${github_owner}/${github_repo}/actions/runners/registration-token")"
unset GITHUB_PAT

REG_TOKEN="$(echo "$${REG_RESPONSE}" | jq -r '.token // empty')"
unset REG_RESPONSE

if [ -z "$${REG_TOKEN}" ]; then
  log "ERROR: GitHub returned no registration token. Check that the PAT has the 'repo' scope and that ${github_owner}/${github_repo} exists."
  exit 1
fi
log "Registration token obtained"

# --replace lets a rebuilt instance take over the same runner name instead of
# leaving a dead registration behind that makes jobs queue forever.
log "Configuring the runner"
sudo -u "$${RUNNER_USER}" env RUNNER_TOKEN="$${REG_TOKEN}" bash -c "
  cd '$${RUNNER_DIR}' &&
  ./config.sh \
    --url 'https://github.com/${github_owner}/${github_repo}' \
    --token \"\$RUNNER_TOKEN\" \
    --name '${runner_name}' \
    --labels '${runner_labels}' \
    --work '_work' \
    --unattended \
    --replace
"
unset REG_TOKEN

# svc.sh must run as root to write the systemd unit, but takes the unprivileged
# account the service will actually run under.
log "Installing and starting the runner service"
cd "$${RUNNER_DIR}"
./svc.sh install "$${RUNNER_USER}"
./svc.sh start
./svc.sh status || true

log "=== Flyway runner bootstrap finished ==="
